@inject ILogger<AgentsCard> logger
@inject BaseballApiClient BaseballApi

<div class="containerFadeIn">
    <div class="card bg-c-lightgray order-card mt-2">
        <div class="card-block">
            <div class="row">
                <div class="col-md-9 col-xl-9">
                    <h6 class="form-text"><span><b>Agentic Research & Analysis with Artificial Intelligence</b></span></h6>
                    <small class="form-text text-muted">Selected Agents: @(this.GetSelectedAgentNames()) </small>
                    <div class="m-b-0">...<span class="f-right"></span></div>
                </div>
                <div class="col-md-3 col-xl-3">
                    <div class="btnRunAgentAnalysis @(this.RunAnalysisButtonStyle())" @onclick="runAgenticAnalysisClicked"
                    style="font-size:1.25rem;">
                        <i class="fa-solid fa-person-running"></i>
                        Run Agentic Analysis
                    </div>
                </div>
            </div>
            <div class="row">
                <AgentCard AgentType="BaseballStatistician"
                OnIsSelectedValueChanged="HandleChildValueChanged">
                </AgentCard>
                <AgentCard AgentType="MachineLearningExpert"
                OnIsSelectedValueChanged="HandleChildValueChanged">
                </AgentCard>
                <AgentCard AgentType="BaseballEncyclopedia"
                OnIsSelectedValueChanged="HandleChildValueChanged">
                </AgentCard>
            </div> 
            <div class="row">
                <AgenticAnalysisCard IsVisible="@hasAgenticAnalysisStarted"
                Analysis="@analysis" StatusMessage="@statusMessage">
                </AgenticAnalysisCard>
            </div>
        </div>
    </div>
</div>

@code {
    private bool hasAgenticAnalysisStarted = false;
    private AgenticAnalysisViewModel? analysis;
    private string statusMessage = string.Empty;
    private string? currentBatterId;
    private long analysisVersion;

    private List<string> selectedAgents = new();

    [Parameter]
    public MLBBaseballBatter BaseballBatter { get; set; } = new();

    protected override void OnParametersSet()
    {
        if (currentBatterId != BaseballBatter.ID)
        {
            currentBatterId = BaseballBatter.ID;
            analysisVersion++;
            hasAgenticAnalysisStarted = false;
            analysis = null;
            statusMessage = string.Empty;
        }
    }

    private void HandleChildValueChanged(Agent agent)
    {
        if (agent.IsSelected)
        {
            selectedAgents.Add(agent.AgentType);
        }
        else
        {
            selectedAgents.Remove(agent.AgentType);
        }

        this.StateHasChanged();
    }

    private string GetSelectedAgentNames()
    {
        return string.Join(", ", selectedAgents.Select(a => Agents.GetAgentName(a)));
    }

    private string RunAnalysisButtonStyle()
    {
        if (selectedAgents.Count > 0)
        {
            return string.Empty;
        }
        else
        {
            return "disabled";
        }
    }

    private async Task runAgenticAnalysisClicked()
    {
        if (selectedAgents.Count == 0)
        {
            return;
        }

        var requestVersion = ++analysisVersion;
        analysis = null;
        statusMessage = "Running Agentic Analysis...";
        this.hasAgenticAnalysisStarted = true;

        var agenticAnalysisConfig = new AgenticAnalysisConfig
            {
                AgentsToUse = this.selectedAgents.ToList(),
                BaseballBatter = this.BaseballBatter
            };

        AgenticAnalysisViewModel completedAnalysis;
        try
        {
            if (agenticAnalysisConfig.AgentsToUse.Count > 1)
            {
                statusMessage = "Running Agentic Analysis with multiple research agents and Agent Q...";
                completedAnalysis = await BaseballApi.GetBaseballPlayerAnalysisMultipleModels(agenticAnalysisConfig);
            }
            else
            {
                statusMessage = "Running Agentic Analysis with a single research agent...";
                completedAnalysis = await BaseballApi.GetBaseballPlayerAnalysis(agenticAnalysisConfig);
            }
        }
        catch (Exception ex)
        {
            if (requestVersion == analysisVersion)
            {
                logger.LogWarning(ex, "Agentic analysis failed for the current request.");
                analysis = null;
                statusMessage = "Unable to complete agentic analysis. Please try again.";
            }
            return;
        }

        if (requestVersion == analysisVersion)
        {
            analysis = completedAnalysis;
            statusMessage = string.Empty;
            this.StateHasChanged();
        }
    }
}
